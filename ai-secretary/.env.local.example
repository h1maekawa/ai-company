# App auth (server-only — do NOT prefix with NEXT_PUBLIC_, it would leak to the browser bundle)
AUTH_PASSWORD=
SESSION_SECRET=

# Default provider
DEFAULT_PROVIDER=gemini
NEXT_PUBLIC_DEFAULT_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq fallback
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Ollama local optional
OLLAMA_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_MS=60000

# まえみち Local AI添削（初期値はすべて停止側）
MAEMICHI_LOCAL_AI_ENABLED=false
MAEMICHI_LOCAL_AI_PROVIDER=ollama
# Macの `ollama list` で確認したモデル名を設定する。推測で設定しない。
MAEMICHI_LOCAL_AI_MODEL=
MAEMICHI_LOCAL_AI_JOB_TIMEOUT_SECONDS=300
MAEMICHI_LOCAL_AI_WORKER_TOKEN=
MAEMICHI_LOCAL_AI_WORKER_ID=
MAEMICHI_LOCAL_AI_POLL_INTERVAL_MS=5000
MAEMICHI_LOCAL_AI_FALLBACK_TO_CLOUD=false
# Vault内のブランド規則。取得できなければ添削を停止する。
MAEMICHI_BRAND_RULES_PATH=memory/personal/note/MAEMICHI_BRAND_POSTING_RULES.md

# Obsidian
VAULT_ROOT=/Users/maekawahiroyuki/Library/CloudStorage/Dropbox/maehiro/個人用/AI会社

# ─── まえみち コンテンツリサーチ / 投稿基盤 ───────────────
# すべて任意。未設定でも画面は動き、その機能だけが無効になる。

# 排他制御・二重投稿防止（未設定ならプロセス内フォールバック）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Xリサーチ（official-apiモードのときだけ必要）
X_API_BEARER_TOKEN=
X_API_ENABLED=false
# freeモードの公開検索（未設定ならX側は何も取得しない）
SERPAPI_KEY=
SERPAPI_ENABLED=false

# Buffer（X予約投稿）
BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=
BUFFER_X_CHANNEL_ID=
BUFFER_ENABLED=false

# X無料ワークスペース（公式埋め込み＋Web Intents、人間が最終投稿）
X_OFFICIAL_EMBED_ENABLED=true
X_WEB_INTENTS_ENABLED=true
X_ARCHIVE_IMPORT_ENABLED=true
AI_PROVIDER_ORDER=ollama,gemini
AI_REQUIRE_FREE_TIER=true
AI_ALLOW_PAID_FALLBACK=false
GEMINI_ALLOW_BILLING=false
# Googleの現行無料枠を確認し、利用を許可するモデル名だけをカンマ区切りで指定
GEMINI_FREE_MODELS=

# Slack（コマンド・承認）
# 署名検証に必須。未設定だとSlackからの全リクエストを拒否する
SLACK_SIGNING_SECRET=
# 通知の送り先はどちらか一方でよい
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Vercel Cron（毎朝のリサーチ）。未設定だとcronは401で拒否される
# vercel.json は 22:00 UTC = 翌07:00 JST に実行する
CRON_SECRET=

# note投稿のローカルPlaywrightランナー。未設定だとジョブを渡さない
LOCAL_RUNNER_TOKEN=
APP_BASE_URL=https://ai-company-ilqd.vercel.app

# note自動公開の安全装置（既定はすべて停止側）
NOTE_AUTOPUBLISH_ENABLED=false
NOTE_DRAFT_ONLY=true
NOTE_PAID_PUBLISH_REQUIRE_CONFIRM=true

# 毎日08:00 JSTにX投稿案を生成する。falseならcronは何もしない。
X_DAILY_AUTOMATION_ENABLED=false
