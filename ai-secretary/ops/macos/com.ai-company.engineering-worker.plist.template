<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ai-company.engineering-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROJECT_DIR__/scripts/run-engineering.sh</string>
    <string>daemon</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME_DIR__</string>
    <key>ENGINEERING_WORKSPACE_DIR</key>
    <string>__WORKSPACE_DIR__</string>
    <key>ENGINEERING_REPO_DIR</key>
    <string>__REPO_DIR__</string>
    <key>ENGINEERING_MACHINE_ID</key>
    <string>__MACHINE_ID__</string>
    <key>ENGINEERING_AGENT_AUTH_MODE</key>
    <string>__AGENT_AUTH_MODE__</string>
    <key>ENGINEERING_CODEX_HOME</key>
    <string>__CODEX_HOME__</string>
    <key>ENGINEERING_WORKER_ENABLED</key>
    <string>true</string>
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__WORKSPACE_DIR__/logs/launchd.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__WORKSPACE_DIR__/logs/launchd.stderr.log</string>
  <key>ThrottleInterval</key>
  <integer>30</integer>
</dict>
</plist>
